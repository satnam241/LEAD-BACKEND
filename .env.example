# ── Local LLM (Llamafile) Configuration ──────────────────────────────
# Llamafile server running locally (e.g. llamafile-0.10.6 --server --model Llama-3.2-3B-Instruct-Q4_K_M.gguf)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=512

# Enable AI chatbot on WhatsApp
AI_CHATBOT_ENABLED=true

# Number of past conversation messages passed for context
AI_HISTORY_MESSAGES=8

# Maximum length of the WhatsApp response in characters
AI_MAX_REPLY_CHARS=600
